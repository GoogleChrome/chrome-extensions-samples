{
  "name": "URL blocker",
  "version": "0.1",
  "manifest_version": 3,
  "description": "A declarativeNetRequest rule that blocks navigation to example.com and its subdomains.",
  "background": {
    "service_worker": "service_worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules_1.json"
      }
    ]
  },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback"]
}
