{
  "name": "URL redirect",
  "version": "0.1",
  "manifest_version": 3,
  "description": "Redirects example.com/original to example.com/redirected with a declarativeNetRequest rule.",
  "background": {
    "service_worker": "service_worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules_1.json"
      }
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["https://example.com/*"]
}
