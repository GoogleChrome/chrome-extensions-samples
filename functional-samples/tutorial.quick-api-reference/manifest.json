{
  "manifest_version": 3,
  "name": "Quick API reference",
  "description": "Quick API speeds up building Chrome extensions by opening API reference pages from the address bar and showing a daily tip.",
  "version": "1.0.0",
  "icons": {
    "16": "images/icon-16.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "102",
  "omnibox": {
    "keyword": "api"
  },
  "permissions": ["alarms", "storage"],
  "content_scripts": [
    {
      "matches": ["https://developer.chrome.com/docs/extensions/reference/*"],
      "js": ["content.js"]
    }
  ]
}
